<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ package visibility: the optional satellite lives in its own
         APK, so the client must declare it to detect and bind to it. -->
    <queries>
        <package android:name="com.caramel.roadloader.satellite" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Road Loader"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Same-APK companion. It runs in its own process so the UI survives a
             companion fault; a 32-bit-only satellite APK provides the real
             armeabi-v7a engine on devices that support it. -->
        <service
            android:name=".RoadLoaderService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":road32" />
    </application>
</manifest>
